      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Margen cedido por promociones, por categoría",
          "description": "Estimación del margen adicional (en euros) que se habría obtenido en 2024–2025 si las ventas en promoción hubieran tenido el margen normal de su categoría. Prescription concentra más de un tercio del total (28,7 k€), seguida de OTC (16,3 k€) y Wellness (15,4 k€). Sirve para decidir en qué categorías conviene limitar o rediseñar las promociones.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "ds-influx"
                      },
                      "spec": {
                        "query": "from(bucket: \"ventas_mensuales\")\r\n  |> range(start: 2024-01-01T00:00:00Z, stop: 2026-01-01T00:00:00Z)\r\n  |> filter(fn: (r) => r._measurement == \"ventas\" and (r._field == \"ingresos_eur\" or r._field == \"margen_eur\"))\r\n  |> map(fn: (r) => ({r with k: r._field + \"_\" + r.PromoFlag}))\r\n  |> group(columns: [\"Category\", \"k\"])\r\n  |> sum()\r\n  |> pivot(rowKey: [\"Category\"], columnKey: [\"k\"], valueColumn: \"_value\")\r\n  |> map(fn: (r) => ({\r\n       Category: r.Category,\r\n       margen_cedido_eur: r.ingresos_eur_Yes * (r.margen_eur_No / r.ingresos_eur_No) - r.margen_eur_Yes\r\n     }))\r\n  |> group()\r\n  |> sort(columns: [\"margen_cedido_eur\"], desc: true)"
                      }
