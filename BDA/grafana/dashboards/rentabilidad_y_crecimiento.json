      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Crecimiento de ingresos por país (2025 vs 2024)",
          "description": "Variación porcentual de los ingresos entre 2024 y 2025 en cada mercado",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "ds-influx"
                      },
                      "spec": {
                        "query": "import \"date\"\r\n\r\nfrom(bucket: \"ventas_mensuales\")\r\n  |> range(start: 2024-01-01T00:00:00Z, stop: 2026-01-01T00:00:00Z)\r\n  |> filter(fn: (r) => r._measurement == \"ventas\" and r._field == \"ingresos_eur\")\r\n  |> map(fn: (r) => ({r with year: string(v: date.year(t: r._time))}))\r\n  |> group(columns: [\"Country\", \"year\"])\r\n  |> sum()\r\n  |> pivot(rowKey: [\"Country\"], columnKey: [\"year\"], valueColumn: \"_value\")\r\n  |> map(fn: (r) => ({Country: r.Country, growth_pct: (r[\"2025\"] / r[\"2024\"] - 1.0) * 100.0}))\r\n  |> group()\r\n  |> sort(columns: [\"growth_pct\"], desc: true)"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
