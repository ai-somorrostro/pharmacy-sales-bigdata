                      "group": "influxdb",
                      "kind": "DataQuery",
                      "spec": {
                        "query": "from(bucket: \"ventas_diarias\")\r\n  |> range(start: 2024-01-01T00:00:00Z, stop: 2026-01-01T00:00:00Z)\r\n  |> filter(fn: (r) => r._measurement == \"ventas\" and (r._field == \"margen_eur\" or r._field == \"ingresos_eur\"))\r\n  |> group(columns: [\"PromoFlag\", \"_field\"])\r\n  |> sum()\r\n  |> pivot(rowKey: [\"PromoFlag\"], columnKey: [\"_field\"], valueColumn: \"_value\")\r\n  |> map(fn: (r) => ({PromoFlag: r.PromoFlag, margen_pct: r.margen_eur / r.ingresos_eur * 100.0}))\r\n  |> group()"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Margen porcentual sobre ingresos de las ventas con promoción frente a las ventas sin promoción (2024–2025). Las promociones dejan unos 9 puntos menos de margen (19,9 % frente a 29,0 %) sin aumentar las unidades por venta.",
