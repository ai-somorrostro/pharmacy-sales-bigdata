    {
        "id": "2c24c7bbe71bb72a",
        "type": "function",
        "z": "700f9ac353fb36c9",
        "name": "a puntos de InfluxDB",
        "func": "const rows = msg.payload;\nconst CHUNK = 5000;\n\nfor (let i = 0; i < rows.length; i += CHUNK) {\n    const pts = rows.slice(i, i + CHUNK).map(r => {\n        let f = String(r.Fecha).trim();\n        if (f.includes(' ')) f = f.replace(' ', 'T');\n        return {\n            measurement: \"ventas\",\n            tags: {\n                Country: String(r.Country),\n                Category: String(r.Category),\n                PromoFlag: String(r.PromoFlag)\n            },\n            fields: {\n                ventas: Number(r.ventas),\n                unidades: Number(r.unidades),\n                ingresos_eur: Number(r.ingresos_eur),\n                costes_eur: Number(r.costes_eur),\n                margen_eur: Number(r.margen_eur)\n            },\n            timestamp: new Date(f).getTime()\n        };\n    });\n    node.send({ payload: pts });\n}\nnode.status({ text: rows.length + \" filas enviadas\" });\nreturn null;",
