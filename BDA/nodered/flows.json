    {
        "id": "eab6a3408c797a82",
        "type": "function",
        "z": "700f9ac353fb36c9",
        "name": "a puntos de InfluxDB",
        "func": "const r = msg.payload;\n\nconst num = (x) => Number(x);\nconst valores = {\n    ventas: num(r.ventas),\n    unidades: num(r.unidades),\n    ingresos_eur: num(r.ingresos_eur),\n    costes_eur: num(r.costes_eur),\n    margen_eur: num(r.margen_eur)\n};\n\n// Fecha del CSV (\"2026-01-01 00:00:00+00:00\") a milisegundos\nconst ts = new Date(String(r.Fecha).replace(\" \", \"T\")).getTime();\n\n// Si algún valor no es válido (cabecera, línea vacía...), se descarta la fila\nif (!r.Country || !Number.isFinite(ts) || Object.values(valores).some(v => !Number.isFinite(v))) {\n    node.warn(\"Fila descartada: \" + JSON.stringify(r));\n    return null;\n}\n\nmsg.payload = [{\n    measurement: \"ventas\",\n    tags: {\n        Country: String(r.Country),\n        Category: String(r.Category),\n        PromoFlag: String(r.PromoFlag)\n    },\n    fields: valores,\n    timestamp: ts\n}];\n\nlet n = (context.get(\"n\") || 0) + 1;\ncontext.set(\"n\", n);\nnode.status({ fill: \"green\", shape: \"dot\", text: n + \" filas enviadas\" });\n\nreturn msg;",
