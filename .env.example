# ==========================================
# Versiones fijas de las imágenes (Docker)
# ==========================================
INFLUXDB_VERSION=2.7.10
GRAFANA_VERSION=11.2.0
NODERED_VERSION=4.0.2
NODERED_INFLUX_NODE_VERSION=3.1.5
NODE_VERSION=20-alpine
MCP_VERSION=0.1.0

# ==========================================
# Puertos de los servicios
# ==========================================
INFLUX_PORT=8086
GRAFANA_PORT=3000
NODERED_PORT=1880
MCP_PORT=8080

# ==========================================
# Configuración e Identificación de InfluxDB
# ==========================================
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=pon_aqui_tu_password_admin
INFLUX_ORG=tu_organizacion
INFLUX_BUCKET_DAILY=bucket_diario
INFLUX_BUCKET_MONTHLY=bucket_mensual

# ==========================================
# Tokens de InfluxDB (Reales solo en .env)
# ==========================================
INFLUX_ADMIN_TOKEN=token_admin_de_ejemplo_aqui
INFLUX_READ_TOKEN=token_solo_lectura_de_ejemplo_aqui
INFLUX_WRITE_TOKEN=token_escritura_de_ejemplo_aqui

# ==========================================
# Configuración de Grafana
# ==========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=pon_aqui_tu_password_grafana

# ==========================================
# Rutas locales
# ==========================================
DATA_DIR=./BDA