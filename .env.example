# ==========================================
# Versiones fijas de las imágenes (Docker)
# ==========================================
INFLUXDB_VERSION=2.7.10
GRAFANA_VERSION=11.2.0
NODERED_VERSION=4.0.2
NODERED_INFLUX_NODE_VERSION=3.1.5
GRAFANA_MCP_VERSION=2.0.2

# ==========================================
# Puertos publicados en el host
# Solo informativos: los puertos reales
# están fijados en docker-compose.yml
# ==========================================
INFLUX_PORT=8087
GRAFANA_PORT=3000
NODERED_PORT=1881
MCP_PORT=8000

# ==========================================
# Configuración e Identificación de InfluxDB
# OJO: el nombre de la organización y el de
# los buckets aparecen escritos a mano en las
# consultas Flux de los dashboards y de las
# alertas. Si los cambias, actualiza también
# BDA/grafana/dashboards/ y
# BDA/grafana/provisioning/alerting/rules.json
# ==========================================
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=pon_aqui_tu_password_admin
INFLUX_ORG=tu_organizacion
INFLUX_BUCKET_DAILY=bucket_diario
INFLUX_BUCKET_MONTHLY=bucket_mensual

# ==========================================
# Tokens de InfluxDB (reales solo en .env)
# - INFLUX_ADMIN_TOKEN: panel de administración
# - INFLUX_READ_TOKEN:  lo usa el datasource de Grafana
# - INFLUX_WRITE_TOKEN: lo usa Node-RED para escribir
#   (se inyecta solo en el flujo al arrancar)
# ==========================================
INFLUX_ADMIN_TOKEN=token_admin_de_ejemplo_aqui
INFLUX_READ_TOKEN=token_solo_lectura_de_ejemplo_aqui
INFLUX_WRITE_TOKEN=token_escritura_de_ejemplo_aqui

# ==========================================
# Configuración de Grafana
# ==========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=pon_aqui_tu_password_grafana

# ==========================================
# Servidor MCP de Grafana
# GRAFANA_MCP_TOKEN debe ser el token de un
# service account de Grafana con permiso de
# lectura sobre los dashboards
# ==========================================
GRAFANA_MCP_TOKEN=token_service_account_de_ejemplo_aqui
GRAFANA_MCP_PORT=8000

# Token que usa el cliente MCP (opencode.json)
MCP_GRAFANA_SERVER_TOKEN=token_service_account_de_ejemplo_aqui

# ==========================================
# Email para las alertas de Grafana
# En Gmail hace falta una "app password"
# ==========================================
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password

# Rutas locales
DATA_DIR=./BDA
