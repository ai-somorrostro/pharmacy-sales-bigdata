# ==========================================
# Versiones fijas de las imágenes (Docker)
# ==========================================
INFLUXDB_VERSION=2.7.10
# 13.x: los dashboards están en el formato dashboard.grafana.app/v2
GRAFANA_VERSION=13.2.3
NODERED_VERSION=4.0.2
# Versión del paquete npm node-red-contrib-influxdb
NODERED_INFLUX_NODE_VERSION=0.7.0
GRAFANA_MCP_VERSION=2.0.2

# ==========================================
# Configuración e Identificación de InfluxDB
# OJO: el nombre de la organización y el de
# los buckets aparecen escritos a mano en las
# consultas Flux de los dashboards y de las
# alertas. Si los cambias, actualiza también
# BDA/grafana/dashboards/ y
# BDA/grafana/provisioning/alerting/rules.json
#
# Solo se aplican la primera vez que se crea
# el volumen de InfluxDB. Para cambiarlos
# después: ./deploy.sh clean
# ==========================================
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=pon_aqui_tu_password_admin
INFLUX_ORG=farmacias-europa
INFLUX_BUCKET_DAILY=ventas_diarias
INFLUX_BUCKET_MONTHLY=ventas_mensuales

# ==========================================
# Tokens de InfluxDB (reales solo en .env)
# - INFLUX_ADMIN_TOKEN: lo eliges tú antes del
#   primer arranque. Para generar uno:
#   openssl rand -base64 64 | tr -d '\n'
# - INFLUX_READ_TOKEN:  lo usa el datasource de Grafana
# - INFLUX_WRITE_TOKEN: lo usa Node-RED para escribir
#   (se inyecta solo en el flujo al arrancar)
#
# Deja vacíos los de lectura y escritura:
# InfluxDB genera los tokens y no permite
# elegir su valor. Tras el primer
# "./deploy.sh up", ejecuta
# "./deploy.sh influx-tokens" y se rellenan
# aquí automáticamente.
# ==========================================
INFLUX_ADMIN_TOKEN=pon_aqui_un_token_admin_largo_y_aleatorio
INFLUX_READ_TOKEN=
INFLUX_WRITE_TOKEN=

# ==========================================
# Configuración de Grafana
# ==========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=pon_aqui_tu_password_grafana

# ==========================================
# Servidor MCP de Grafana
# Deja vacíos los dos tokens: con Grafana ya
# levantado, "./deploy.sh mcp-token" crea el
# service account (rol GRAFANA_MCP_ROLE), y
# rellena ambos tokens y mcp-token.txt.
# - GRAFANA_MCP_TOKEN: token del service
#   account (el MCP lo usa contra Grafana)
# - MCP_GRAFANA_SERVER_TOKEN: token que deben
#   presentar los clientes MCP (opencode.json)
# ==========================================
GRAFANA_MCP_TOKEN=
MCP_GRAFANA_SERVER_TOKEN=
GRAFANA_MCP_ROLE=Viewer
GRAFANA_MCP_PORT=8000

# ==========================================
# Email para las alertas de Grafana
# En Gmail hace falta una "app password"
# ==========================================
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password

# Rutas locales
DATA_DIR=./BDA
