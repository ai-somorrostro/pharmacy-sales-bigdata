# ==========================================
# Secretos (nunca al repositorio)
# ==========================================
.env
# Credenciales de Node-RED
*_cred.json
# Token del cliente MCP (lo genera ./deploy.sh mcp-token)
mcp-token.txt

# ==========================================
# Entornos y cachés de Python / Jupyter
# ==========================================
.venv/
venv/
.venv-wsl/
__pycache__/
.ipynb_checkpoints/

# ==========================================
# Node
# ==========================================
node_modules/

# ==========================================
# Sistema operativo y editores
# ==========================================
# Metadatos que Windows añade a los ficheros copiados a WSL
*:Zone.Identifier
Thumbs.db
.DS_Store
.vscode/
.idea/

# ==========================================
# Datos
# Solo se versionan el dataset original y los
# CSV que lee Node-RED; el resto se regenera
# con los notebooks.
# ==========================================
Data/*
*.xlsx
*.csv
!Data/Pharmacy_data.xlsx
!BDA/ventas_diarias.csv
!BDA/ventas_mensuales.csv
!BDA/ventas_simuladas.csv
